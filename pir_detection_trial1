int pirPin = 27;

bool motionState = false;
bool lastMotionState = false;
unsigned long motionStartTime = 0;
unsigned long lastMotionTime = 0;

void setup() {
  pinMode(pirPin, INPUT);
  Serial.begin(115200);
  Serial.println("========================================");
  Serial.println("   PIR Motion Monitoring System - ESP32   ");
  Serial.println("========================================");
}

void loop() {
  motionState = digitalRead(pirPin);
  unsigned long currentTime = millis();

  // Motion just started
  if (motionState == HIGH && lastMotionState == LOW) {
    motionStartTime = currentTime;
    Serial.println("----------------------------------------");
    Serial.print("[");
    Serial.print(currentTime / 1000);
    Serial.println("s] >> MOTION DETECTED <<");
  }

  // Motion ongoing
  if (motionState == HIGH) {
    unsigned long duration = (currentTime - motionStartTime) / 1000;
    Serial.print("   Status : ACTIVE   |   Duration: ");
    Serial.print(duration);
    Serial.println("s");
    lastMotionTime = currentTime;
  }

  // Motion just stopped
  if (motionState == LOW && lastMotionState == HIGH) {
    unsigned long totalDuration = (currentTime - motionStartTime) / 1000;
    Serial.print("[");
    Serial.print(currentTime / 1000);
    Serial.print("s] Motion ended. Total duration: ");
    Serial.print(totalDuration);
    Serial.println("s");
    Serial.println("----------------------------------------");
  }

  // Idle state
  if (motionState == LOW && lastMotionState == LOW) {
    Serial.print("[");
    Serial.print(currentTime / 1000);
    Serial.println("s] Status : IDLE  |  No motion");
  }

  lastMotionState = motionState;
  delay(500);
}
